# Copy to .env.production, replace every placeholder, then use `--env-file .env.production` with Compose.
# Use a secrets manager in production; do not commit the populated file.
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-secret
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
AI_WORKER_TOKEN=replace-with-a-long-random-shared-secret

PUBLIC_APP_URL=https://calibrex.example.com
CORS_ORIGINS=https://calibrex.example.com
APP_HTTP_PORT=8080

MAIL_FROM=CALIBREX <no-reply@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Use `local` with the persistent apidata volume, or configure an S3-compatible bucket.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=calibrex
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Replace with the reviewed Qdrant release tag selected for the pilot.
QDRANT_IMAGE=qdrant/qdrant:REPLACE_WITH_REVIEWED_VERSION
