# --- service ---
AI_WORKER_TOKEN=                 # shared secret with the backend (Bearer). Required when ENV=production
ENV=development
DEVICE=auto                      # auto | cuda | cpu
MAX_CONCURRENCY=1                # simultaneous inferences per process (GPU: keep 1)

# --- localization (fine-tuned Calibrex YOLO, class-agnostic boxes) ---
DETECTOR_BACKEND=yolo
YOLO_WEIGHTS=runs/detect/runs/detect/calibrex_s960/weights/best.pt
# Docker Compose uses /srv/calibrex-best.pt, baked into the worker image.
DET_IMGSZ=1280
DET_CONF=0.25
DET_IOU=0.6                                # NMS IoU: raise for tightly packed items
DET_MAX=1000
TILE_TRIGGER_PX=2200                       # images with a longer side above this are also run tiled
TILE_SIZE=1280
TILE_OVERLAP=0.2

# --- embedding (DINOv2) ---
DINO_MODEL=facebook/dinov2-base            # ViT-B/14, 768-d. Or a local folder for offline use
CROP_PAD=0.04
CROP_SIZE=224
EMBED_BATCH=64
REF_AUGMENT=true                           # also embed a 85% centre crop of every reference photo

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333              # or ":memory:" for a throwaway demo
QDRANT_API_KEY=
QDRANT_COLLECTION=calibrex_refs
SEARCH_K=12                                # raw neighbours per crop, aggregated to top SKUs

# --- crop quality flags (backend demotes SURE -> CHECK when any flag is set) ---
MIN_CROP_SIDE_PX=24
BLUR_LAPLACIAN_VAR=60
GLARE_FRACTION=0.30
