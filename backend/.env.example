# --- development defaults (SQLite, stub inference, console mail) ---
ENV=development
DATABASE_URL=sqlite+aiosqlite:///./data/dev.db
AUTO_CREATE_SCHEMA=true
INFERENCE_BACKEND=stub
STUB_LATENCY_MS=1200
CORS_ORIGINS=http://localhost:5173
SEED_ON_START=false           # opt in only for local fixtures and tests (see scripts/seed.py)
EXPOSE_INVITE_TOKEN=true      # returns the invite token in the API response so demo/e2e can accept it; refused in production

# --- optional inventory/catalog chat assistant ---
# Add your GroqCloud API key here, then restart the backend.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- production (ENV=production enforces these) ---
# ENV=production
# DATABASE_URL=postgresql+asyncpg://calibrex:CHANGE_ME@postgres:5432/calibrex   # then: alembic upgrade head
# AUTO_CREATE_SCHEMA=false
# JWT_SECRET=<random, 32+ chars>       e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
# INFERENCE_BACKEND=http
# AI_WORKER_URL=http://ai-worker:8001
# AI_WORKER_TOKEN=<shared secret with the ai-worker>
# STORAGE_BACKEND=s3                   # or local with a persistent volume; S3_ENDPOINT_URL/S3_BUCKET/S3_ACCESS_KEY/S3_SECRET_KEY
# MAIL_BACKEND=smtp                    # SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASSWORD
# PUBLIC_APP_URL=https://app.example.com
# TRUST_PROXY_HEADERS=true             # only behind your own reverse proxy
# EXPOSE_INVITE_TOKEN=false
