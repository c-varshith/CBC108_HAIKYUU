# The app calls the backend under /api (Vite dev proxy locally, nginx in Docker). Override only if the API lives elsewhere.
# VITE_API_BASE=/api
# Dev proxy target (default http://localhost:8000)
# VITE_DEV_API=http://localhost:8000
# Sample workspace (#/demo) can use the unauthenticated /analyze endpoint. Leave empty for built-in sample data.
VITE_ANALYSIS_API_URL=
